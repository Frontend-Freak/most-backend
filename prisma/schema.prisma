
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
    id Int @id @default(autoincrement())
    email String @unique
    password String
    createdAt DateTime @default(now())
}

model Plan {
    id Int @id @default(autoincrement())
    name String
    description String?
    price Float
    interval String
    createdAt DateTime @default(now())
}